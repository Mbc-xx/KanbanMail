{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KanbanMail",
  "version": "0.1.0",
  "identifier": "io.github.mbc-xx.kanbanmail",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KanbanMail",
        "width": 1200,
        "height": 800,
        "minWidth": 700,
        "minHeight": 450,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; frame-src 'self' about:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
